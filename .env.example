# =============================================================================
# Claude Code 飞书通知 - 环境变量配置
# =============================================================================
# 复制此文件为 .env 并填入实际值
# 脚本会自动从 .env 文件读取配置，无需手动 source
#
# 配置优先级: .env 文件 > 环境变量 > 默认值
# =============================================================================
#
# 配置速查表
# ┌──────────────────────────────┬──────────┬──────────┬──────────┬──────────────────────┐
# │ 配置项                       │ Webhook  │ OpenAPI  │ OpenAPI  │ 默认值               │
# │                              │          │ 单机     │ 分离     │                      │
# ├──────────────────────────────┼──────────┼──────────┼──────────┼──────────────────────┤
# │ FEISHU_SEND_MODE             │ 必填     │ 必填     │ 必填     │ openapi              │
# ├──────────────────────────────┼──────────┼──────────┼──────────┼──────────────────────┤
# │ FEISHU_WEBHOOK_URL           │ 必填     │ -        │ -        │ -                    │
# │ FEISHU_APP_ID                │ -        │ 必填     │ 网关必填 │ -                    │
# │ FEISHU_APP_SECRET            │ -        │ 必填     │ 网关必填 │ -                    │
# │ FEISHU_VERIFICATION_TOKEN    │ -        │ 可选     │ 可选     │ -                    │
# │ FEISHU_GATEWAY_URL           │ -        │ -        │ CB必填   │ -                    │
# │ FEISHU_OWNER_ID              │ 可选     │ 必填     │ 必填     │ -                    │
# ├──────────────────────────────┼──────────┼──────────┼──────────┼──────────────────────┤
# │ CALLBACK_SERVER_PORT         │ 可选     │ 可选     │ 可选     │ 8080                 │
# │ CALLBACK_SERVER_URL          │ 建议     │ 建议     │ 建议     │ localhost:8080       │
# ├──────────────────────────────┼──────────┼──────────┼──────────┼──────────────────────┤
# │ FEISHU_SESSION_MODE          │ 可选     │ 可选     │ 可选     │ message              │
# │ FEISHU_CHAT_ID               │ -        │ 可选     │ 可选     │ -                    │
# │ FEISHU_AT_BOT_ONLY           │ 可选     │ 可选     │ 可选     │ false                │
# │ FEISHU_GROUP_NAME_PREFIX     │ 可选     │ 可选     │ 可选     │ Claude               │
# │ FEISHU_GROUP_DISSOLVE_DAYS   │ 可选     │ 可选     │ 可选     │ 0                    │
# │ SESSION_EXPIRE_DAYS          │ 可选     │ 可选     │ 可选     │ 30                   │
# ├──────────────────────────────┼──────────┼──────────┼──────────┼──────────────────────┤
# │ FEISHU_AT_USER               │ 可选     │ 可选     │ 可选     │ 空                   │
# │ FEISHU_HEADING_STYLE         │ 可选     │ 可选     │ 可选     │ bar                  │
# │ STOP_THINKING_MAX_LENGTH     │ 可选     │ 可选     │ 可选     │ 10000                │
# │ STOP_MESSAGE_MAX_LENGTH      │ 可选     │ 可选     │ 可选     │ 10000                │
# ├──────────────────────────────┼──────────┼──────────┼──────────┼──────────────────────┤
# │ DEFAULT_CHAT_DIR             │ 可选     │ 可选     │ 可选     │ -                    │
# │ DEFAULT_CHAT_FOLLOW_THREAD   │ 可选     │ 可选     │ 可选     │ true                 │
# │ CLAUDE_COMMAND               │ 可选     │ 可选     │ 可选     │ claude               │
# │ CLAUDE_ARGS_TEMPLATE         │ 可选     │ 可选     │ 可选     │ {cmd} {args}         │
# ├──────────────────────────────┼──────────┼──────────┼──────────┼──────────────────────┤
# │ HOOK_USER_PROMPT_ENABLED     │ 可选     │ 可选     │ 可选     │ true                 │
# │ HOOK_PERMISSION_ENABLED      │ 可选     │ 可选     │ 可选     │ true                 │
# │ HOOK_STOP_ENABLED            │ 可选     │ 可选     │ 可选     │ true                 │
# ├──────────────────────────────┼──────────┼──────────┼──────────┼──────────────────────┤
# │ PERMISSION_SOCKET_PATH       │ 可选     │ 可选     │ 可选     │ /tmp/claude-perm...  │
# │ PERMISSION_NOTIFY_DELAY      │ 可选     │ 可选     │ 可选     │ 60                   │
# │ PERMISSION_REQUEST_TIMEOUT   │ 可选     │ 可选     │ 可选     │ 600                  │
# │ CALLBACK_PAGE_CLOSE_DELAY    │ 可选     │ 可选     │ 可选     │ 3                    │
# ├──────────────────────────────┼──────────┼──────────┼──────────┼──────────────────────┤
# │ VSCODE_URI_PREFIX            │ 可选     │ 可选     │ 可选     │ -                    │
# │ ACTIVATE_VSCODE_ON_CALLBACK  │ 可选     │ 可选     │ 可选     │ false                │
# │ VSCODE_SSH_PROXY_PORT        │ 可选     │ 可选     │ 可选     │ -                    │
# ├──────────────────────────────┼──────────┼──────────┼──────────┼──────────────────────┤
# │ PYTHON_PATH                  │ 可选     │ 可选     │ 可选     │ 自动检测             │
# │ TELEMETRY_ENABLED            │ 可选     │ 可选     │ 可选     │ true                 │
# └──────────────────────────────┴──────────┴──────────┴──────────┴──────────────────────┘
# CB必填 = Callback 服务必填

# =============================================================================
# 一、飞书连接（必选）
# =============================================================================

# 发送模式（默认 openapi）
# - webhook: 使用飞书 Webhook 发送（简单，按钮跳转浏览器）⚠️ 不再维护，推荐使用 openapi 模式
# - openapi: 使用飞书 OpenAPI 发送（按钮在飞书内响应，需配置事件订阅）
FEISHU_SEND_MODE=openapi

# --- Webhook 模式 ---
# 飞书 Webhook URL [Webhook 模式必填]
# 从飞书机器人设置中获取
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# --- OpenAPI 模式 — 应用凭证 [单机/网关 必填] ---
#
# 【重要】OpenAPI 模式需要在飞书开放平台配置事件订阅：
#   1. 进入应用管理 -> 事件订阅 -> 添加事件
#   2. 搜索并订阅「卡片回传交互」(card.action.trigger)
#   3. 配置请求地址为 CALLBACK_SERVER_URL（单机）或飞书网关地址（分离）
#   4. 完成 URL 验证（服务需已启动）
#
# --- 部署方式 ---
# OpenAPI 模式支持两种部署方式：
#
# 【单机部署】所有配置在同一台机器
#   - 配置 FEISHU_APP_ID、FEISHU_APP_SECRET、FEISHU_OWNER_ID
#   - HTTP 回调模式需配置 FEISHU_VERIFICATION_TOKEN
#   - 长连接模式（longpoll）无需配置 FEISHU_VERIFICATION_TOKEN
#   - 不配置 FEISHU_GATEWAY_URL
#
# 【分离部署】飞书网关与 Callback 服务分离（多实例场景）
#   - 网关服务: 配置 FEISHU_APP_ID、FEISHU_APP_SECRET
#   - Callback 服务: 配置 FEISHU_GATEWAY_URL（推荐 ws:// 格式）、FEISHU_OWNER_ID
#   - 每个 Callback 服务可以发给不同用户（通过各自的 FEISHU_OWNER_ID）
#   - WS 隧道模式: Callback 主动连接网关，无需公网可达（本地开发推荐）

# 从飞书开放平台 -> 应用管理 -> 凭证与基础信息 获取
# 分离部署时仅网关服务需要配置
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Verification Token [HTTP 回调模式建议配置，长连接模式不需要]
# 从飞书开放平台 -> 应用管理 -> 事件订阅 -> 加密与签名 获取
# 用于验证飞书 HTTP 回调请求的来源，防止伪造请求
# 长连接模式（longpoll）下不需要配置此项
# HTTP 回调模式下未配置会跳过验证（有安全风险，但为了兼容性保留）
FEISHU_VERIFICATION_TOKEN=

# --- OpenAPI 模式 — 网关（分离部署）---
# 飞书网关地址 [分离部署 Callback 必填]
# 配置后，消息通过飞书网关发送，本机无需配置飞书应用凭证
# 协议头决定连接模式：
#   - ws://host:port 或 wss://host:port → WS 隧道模式（Callback 无需公网可达，推荐）
#   - http://host:port 或 https://host:port → HTTP 回调模式（Callback 需公网可达）
FEISHU_GATEWAY_URL=

# --- 消息接收者 ---
# 飞书用户 ID [OpenAPI 必填]
# 必须使用 user_id 格式（纯数字或字母数字组合），服务启动时会校验格式
# 获取方式：https://open.feishu.cn/document/faq/trouble-shooting/how-to-obtain-user-id
# Webhook 模式下可选，仅用于通知 @ 用户
FEISHU_OWNER_ID=

# =============================================================================
# 二、回调服务
# =============================================================================
# 分离部署时，仅 Callback 服务需要配置此部分，网关服务不需要

# 回调服务器端口 [可选, 默认 8080]
CALLBACK_SERVER_PORT=8080

# 回调服务器地址 [视部署模式]
# 主要用于 Hook 脚本与本机 Callback 服务之间的内部通信（权限审批、会话路由等）
#
# 何时 localhost 即可：
#   - 单机 + lark-oapi（长连接模式）：飞书事件通过 SDK WebSocket 接收
#   - 分离 + WS 隧道模式：飞书事件通过 WS 隧道接收
# 何时需要公网地址：
#   - 单机 + 无 lark-oapi（HTTP 回调模式）：飞书平台需要能访问此 URL 推送事件
#   - 分离 + HTTP 模式：网关需要能访问此 URL
CALLBACK_SERVER_URL=http://localhost:8080

# =============================================================================
# 三、会话与消息行为
# =============================================================================

# 会话模式 [可选, 默认 message]
# 控制 Claude 会话的消息隔离方式
#   - message: 普通消息模式，所有消息在同一群聊/私聊中（默认）
#   - thread: 话题模式，消息回复到话题详情中
#   - group: 群聊模式，每个会话自动创建独立飞书群聊（需额外申请 im:chat 权限）
FEISHU_SESSION_MODE=message

# 飞书群聊 ID [可选, message/thread 模式]
# 指定消息发送到某个群聊（oc_ 开头的群聊 ID）
# 不配置则默认发送到用户与机器人的私聊会话中
FEISHU_CHAT_ID=

# [已废弃] 话题内回复模式，已被 FEISHU_SESSION_MODE=thread 替代
# 控制回复消息是否收进话题详情（不刷群聊主界面）
#   - false: 回复消息正常显示在群聊主界面（默认）
#   - true: 回复消息仅出现在话题详情中，不会冒泡到群聊主界面
# 仅为向后兼容保留：FEISHU_REPLY_IN_THREAD=true 等同于 FEISHU_SESSION_MODE=thread
# 若已配置 FEISHU_SESSION_MODE，此项将被忽略
#FEISHU_REPLY_IN_THREAD=false

# 群聊 @bot 过滤 [可选, 默认 false]
# 控制群聊中是否仅响应 @bot 的消息
#   - false: 处理群聊中的所有消息（默认）
#   - true: 群聊中只处理 @bot 的消息，其他消息静默忽略
# 注意：
#   - P2P 单聊不受此配置影响，始终响应
#   - 若飞书应用未开通"获取群组中所有消息"权限，应用仅能收到 @bot 的消息，
#     此时无论该配置值为何，效果等同 true
FEISHU_AT_BOT_ONLY=false

# 群聊名称前缀 [可选, 默认 Claude]
# group 模式下创建的群聊名称格式: {前缀} - #{序号} - {目录名} - {YYYYMMDD}
# 仅在 FEISHU_SESSION_MODE=group 时生效
FEISHU_GROUP_NAME_PREFIX=Claude

# 群聊空闲自动解散天数 [可选, 默认 0]
# group 模式下，群聊超过指定天数无活动则自动解散
# 设为 0 表示不自动解散（群聊记录仍会保留，可通过 /groups dissolve 手动清理）
# 仅在 FEISHU_SESSION_MODE=group 时生效
FEISHU_GROUP_DISSOLVE_DAYS=0

# Session 过期天数 [可选, 默认 30]
# 超过此天数的 session 将被清理，继续对话时若 session 已过期会提示 /new
# 设为 0 或负值无效（强制使用默认 30 天），防止 session 数据无限膨胀
SESSION_EXPIRE_DAYS=30

# =============================================================================
# 四、消息显示
# =============================================================================

# 飞书通知 @ 用户配置 [可选]
# 适用于所有飞书通知（权限请求、任务完成等），与发送模式无关
# 支持以下格式:
#   - 空: 默认 @ FEISHU_OWNER_ID 用户
#   - all: @ 所有人
#   - off: 不 @ 任何人
FEISHU_AT_USER=

# Markdown 标题样式 [可选, 默认 bar]
# 控制 Claude 响应中 Markdown 标题在飞书卡片中的渲染方式
#   - bar: 竖线粗细递减（▍ ▎ ▏）（默认）
#   - circle: 蓝色圆形递减（🔵 🔘 ● ○ ◦）
#   - diamond: 蓝色菱形递减（🔷 🔹 ◆ ◇ ◦）
#   - original: 保留原始 # 标题语法（飞书对标题渲染支持有限）
# 注意：所有降级方案中一级标题统一使用 **【标题】** 格式
FEISHU_HEADING_STYLE=bar

# Stop 事件思考过程最大长度，字符数 [可选, 默认 10000]
# 设为 0 则不显示思考过程
# 注意：飞书卡片 JSON 限制 30KB，message + thinking 总字符数建议不超过 20000
STOP_THINKING_MAX_LENGTH=10000

# Stop 事件消息最大长度，字符数 [可选, 默认 10000]
# 主 Agent 完成时，发送飞书通知中显示的响应内容最大长度
# 超过此长度会被截断并添加 "..."
STOP_MESSAGE_MAX_LENGTH=10000

# =============================================================================
# 五、Claude 会话配置
# =============================================================================

# 默认聊天目录 [可选]
# 配置后，直接发送消息（无指令前缀）会自动在该目录创建/继续 Claude 会话
# /new prompt（无 --dir）也会直接使用该目录，跳过目录选择卡片
# 未配置时保持原有行为（需使用 /new 指令或回复消息）
# 服务启动时会自动创建不存在的目录
DEFAULT_CHAT_DIR=

# 默认聊天目录话题跟随模式 [可选, 默认 true]
# true: 跟随 FEISHU_SESSION_MODE 全局配置
# false: 默认聊天目录的回复始终在主界面显示（不收敛进话题）
DEFAULT_CHAT_FOLLOW_THREAD=true

# Agent 类型 [可选, 默认 claude]
# 支持 claude 或 codex，决定使用哪个 AI 编码代理后端
AGENT_TYPE=claude

# Claude 命令 [可选, 默认 claude]
# 用于继续会话和新建会话功能
#
# 单命令配置（向后兼容）:
#   CLAUDE_COMMAND=claude
#   CLAUDE_COMMAND=claude --model opus
#
# 多命令配置（列表格式，无需引号）:
#   CLAUDE_COMMAND=[claude, claude --model opus]
#
# 也兼容 JSON 数组格式:
#   CLAUDE_COMMAND=["claude", "claude --model opus"]
#
# 配置多个命令后:
#   - 默认使用列表第一个
#   - /new 卡片支持选择
#   - /new --cmd=1 或 /new --cmd=opus 指定使用哪个（索引从 0 开始计数）
#   - /reply --cmd=opus 在回复时指定
#   - 空值或缺失时默认使用 claude
CLAUDE_COMMAND=claude

# Claude 命令行模板 [可选, 默认 '{cmd} {args}']
# 用于兼容 CLI 包装器。仅当 wrapper 的参数语法与 claude 原生不同时才需要改,
# 前缀型 wrapper(直接透传 argv)写进 CLAUDE_COMMAND 即可。
#
# 示例: 某第三方 wrapper 使用 -a 把所有 claude 参数包成一个字符串传入,
#   实际执行效果: ccsdk code -t claude -a "--print <prompt>"
#   配置如下:
#     CLAUDE_COMMAND=ccsdk code -t claude
#     CLAUDE_ARGS_TEMPLATE={cmd} -a "{args}"
CLAUDE_ARGS_TEMPLATE={cmd} {args}

# Codex 命令 [可选, 默认 codex]
# 仅当 AGENT_TYPE=codex 时生效，格式与 CLAUDE_COMMAND 相同
# CODEX_COMMAND=codex
# CODEX_COMMAND=[codex, codex --model o3-pro]
CODEX_COMMAND=codex

# Codex 命令行模板 [可选, 默认 '{cmd} {args}']
# 仅当 AGENT_TYPE=codex 时生效，语义与 CLAUDE_ARGS_TEMPLATE 相同
CODEX_ARGS_TEMPLATE={cmd} {args}

# =============================================================================
# 六、Hook 事件开关
# =============================================================================

# 控制各 Hook 事件是否启用，设为 false 可关闭对应事件的处理
# 关闭后 PermissionRequest 回退到终端交互，其他事件静默跳过

# 用户提交 Hook（用户 prompt 同步到飞书）
HOOK_USER_PROMPT_ENABLED=true

# 权限请求 Hook（关闭后回退到终端审批）
HOOK_PERMISSION_ENABLED=true

# 停止事件 Hook（任务完成通知）
HOOK_STOP_ENABLED=true

# =============================================================================
# 七、权限请求
# =============================================================================

# Unix Socket 路径 [可选, 默认 /tmp/claude-permission.sock]
# 用于 PermissionRequest hook 与回调服务器之间的通信
PERMISSION_SOCKET_PATH=/tmp/claude-permission.sock

# 权限通知延迟时间，秒 [可选, 默认 60]
# 当 Claude 触发权限请求时，会推送审批卡片到飞书
# 延迟发送可避免在终端实时审批时收到不必要的飞书通知
# 设为 0 表示立即发送
PERMISSION_NOTIFY_DELAY=60

# 权限请求超时时间，秒 [可选, 默认 600]
# 用户在此时间内未响应，将回退到终端交互
PERMISSION_REQUEST_TIMEOUT=600

# 回调页面自动关闭时间，秒 [可选, 默认 3]
# 用户点击按钮跳转浏览器后，回调页面显示的倒计时秒数
# 仅 webhook 模式使用，openapi 模式按钮在飞书内响应，不涉及浏览器页面
# 建议范围: 1-10 秒
CALLBACK_PAGE_CLOSE_DELAY=3

# =============================================================================
# 八、VSCode 集成（可选）
# =============================================================================
#
# 【模式一】浏览器跳转模式 - VSCODE_URI_PREFIX
# -----------------------------------------------------------------------------
# 原理：点击飞书按钮后，浏览器回调页面通过 vscode:// 协议链接跳转到 VSCode
# 优点：配置简单，无需额外服务
# 缺点：受浏览器安全策略限制，可能触发跳转确认弹窗
#
# 格式: vscode://vscode-remote/{remote-type}+{host} 或 vscode://file
# 示例:
#   - SSH Remote: vscode://vscode-remote/ssh-remote+myserver
#   - WSL: vscode://vscode-remote/wsl+Ubuntu
#   - 本地: vscode://file (用于本地开发)
#
# 【推荐】VSCode 设置，允许外部应用直接打开（无需确认）：
#   - 本地: settings.json 添加 "security.promptForLocalFileProtocolHandling": false
#   - 远程: settings.json 添加 "security.promptForRemoteFileProtocolHandling": false
#
VSCODE_URI_PREFIX=

# 【模式二】自动激活模式 - ACTIVATE_VSCODE_ON_CALLBACK (推荐)
# -----------------------------------------------------------------------------
# 原理：服务端直接调用命令激活 VSCode 窗口，不依赖浏览器跳转
# 优点：不受浏览器策略限制，体验更流畅
# 缺点：SSH Remote 场景需要配合反向隧道代理
#
# --- 本地开发场景 ---
# 仅配置此项为 true 即可，服务端会执行 'code .' 激活本地 VSCode 窗口
ACTIVATE_VSCODE_ON_CALLBACK=false
#
# --- SSH Remote 远程开发场景 ---
# 结合上述配置，再配置 VSCODE_SSH_PROXY_PORT 即可
# 通过反向 SSH 隧道唤起本地 VSCode 窗口
#
# 使用方法:
#   1. 在本地电脑运行代理服务:
#      python3 src/proxy/vscode_ssh_proxy.py --vps <host> [options]
#        --vps HOST        VPS 的 SSH 地址 (别名如 myserver，或 root@1.2.3.4)
#        --ssh-port PORT   SSH 端口 (默认: 22，使用别名时从 ~/.ssh/config 读取)
#        -p, --port        本地 HTTP 服务端口 (默认: 9527)
#        -r, --remote-port VPS 端远程端口 (默认: 同本地端口)
#   2. 点击飞书按钮会自动唤起本地 VSCode
#
# 注意: VSCODE_SSH_PROXY_PORT 需与代理服务的 --remote-port 参数保持一致 (如 9527)
VSCODE_SSH_PROXY_PORT=

# =============================================================================
# 九、其他
# =============================================================================

# Python 3 解释器路径 [可选, 自动检测]
# setup.sh 会自动写入检测到的 Python 路径，确保运行时与安装时使用相同的 Python
# 如果使用 venv/conda 环境安装了依赖，此项会记录该环境的 Python 路径
# 手动修改此值可覆盖自动检测结果
PYTHON_PATH=

# 遥测 [可选, 默认 true]
# 用于统计活跃用户数量和检测版本更新
# 数据包含：匿名客户端 ID、版本号、操作系统、git 仓库路径（仅 user/repo）
# - true: 启用遥测（默认）
# - false: 禁用遥测
TELEMETRY_ENABLED=true
